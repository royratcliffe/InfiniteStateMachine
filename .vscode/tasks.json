{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "label": "prettify_json",
      "type": "shell",
      "command": "python scripts/prettify_json.py",
      "problemMatcher": [
        "$python"
      ]
    },
    {
      "label": "extract_st",
      "type": "shell",
      "command": "python scripts/extract_st.py",
      "problemMatcher": [
        "$python"
      ],
      "dependsOn": [
        "remove .gitignore"
      ]
    },
    {
      "label": "update_st",
      "type": "shell",
      "command": "python scripts/update_st.py",
      "problemMatcher": [
        "$python"
      ],
      "dependsOn": [
        "remove .gitignore"
      ]
    },
    {
      "label": "update_version",
      "type": "shell",
      "command": "python scripts/update_version.py",
      "problemMatcher": [
        "$python"
      ]
    },
    {
      "label": "remove .gitignore",
      "type": "shell",
      "command": "if (Test-Path -LiteralPath .gitignore) { Remove-Item -LiteralPath .gitignore }"
    }
  ]
}
