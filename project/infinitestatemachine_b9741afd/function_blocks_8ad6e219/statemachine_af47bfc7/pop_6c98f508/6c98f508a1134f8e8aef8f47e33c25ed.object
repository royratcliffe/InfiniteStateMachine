          "Implementation": {
            "@Type": "3b83b776",
            "@Value": {
              "TextDocument": {
                "@Type": "f3878285",
                "@Value": {
                  "TextBlobForSerialisation": "(string)IF iDepth > 0 THEN\n\tiDepth := iDepth - 1;\n\tPop := itfStates[iDepth];\n    (*\n     * Clear the popped state from the stack. This is not strictly necessary,\n     * but it can help catch use-after-free bugs.\n     *)\n\titfStates[iDepth] := 0;\nELSE\n\tPop := 0;\nEND_IF\n",
                  "LineInfoPersistence": "(string)6c98f508-a113-4f8e-8aef-8f47e33c25ed_Impl_LineIds"
                }
              }
            }
          },
          "Interface": {
            "@Type": "a9ed5b7e",
            "@Value": {
              "TextDocument": {
                "@Type": "f3878285",
                "@Value": {
                  "TextBlobForSerialisation": "(string)METHOD PROTECTED Pop : IState\nVAR_INPUT\nEND_VAR\n",
                  "LineInfoPersistence": "(string)6c98f508-a113-4f8e-8aef-8f47e33c25ed_Decl_LineIds"
                }
              }
            }
          }
        }
