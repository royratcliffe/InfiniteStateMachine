                "@Type": "f3878285",
                "@Value": {
                  "TextBlobForSerialisation": "(string)Push := iDepth < ISM.gc_iMaxDepth;\nIF Push THEN\n\titfStates[iDepth] := itfState;\n\tiDepth := iDepth + 1;\nEND_IF\n",
                  "LineInfoPersistence": "(string)95a8a034-9180-43ce-8bfd-c478425733d0_Impl_LineIds"
