    "object": {
      "Graph": {
        "@Type": "f8a58466",
        "@Value": {
          "Implementation": {
            "@Type": "3b83b776",
            "@Value": {
              "TextDocument": {
                "@Type": "f3878285",
                "@Value": {
                  "TextBlobForSerialisation": "(string)(*\n * The following do-while loop's condition assumes early-out semantics.\n * It assumes that the second sub-condition does *not* evaluate unless the first sub-condition is true.\n *)\nWHILE iLevel < iDepth AND itfStates[iLevel] <> itfState DO\n\tiLevel := iLevel + 1;\nEND_WHILE\nIn := iLevel < iDepth;\n",
                  "LineInfoPersistence": "(string)e699251b-332a-4a1e-ae9b-43de46a9cbf4_Impl_LineIds"
                }
              }
            }
          },
          "Interface": {
            "@Type": "a9ed5b7e",
            "@Value": {
              "TextDocument": {
                "@Type": "f3878285",
                "@Value": {
                  "TextBlobForSerialisation": "(string)METHOD In : BOOL\nVAR_INPUT\n\titfState: IState;\nEND_VAR\nVAR\n\tiLevel : INT := 0;\nEND_VAR",
                  "LineInfoPersistence": "(string)e699251b-332a-4a1e-ae9b-43de46a9cbf4_Decl_LineIds"
                }
              }
            }
          }
        }
